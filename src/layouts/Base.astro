---
import { brand } from '../config/brand.js';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** GA4 content_group pushed to dataLayer — used to build funnels */
  pageType?: string;
  noindex?: boolean;
}
const { title, description, pageType = 'other', noindex = false } = Astro.props;
const fullTitle = `${title} | ${brand.name}`;
const waHref = `https://wa.me/${brand.phoneE164}?text=${encodeURIComponent(brand.whatsappGreeting)}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeHealthCareService',
  name: brand.name,
  description: brand.tagline,
  url: `https://${brand.domain}`,
  telephone: `+${brand.phoneE164}`,
  email: brand.email,
  areaServed: brand.serviceArea,
  address: { '@type': 'PostalAddress', addressLocality: brand.city, addressRegion: 'Jalisco', addressCountry: 'MX' },
  availableLanguage: ['es', 'en'],
};
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_MX" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Consent Mode v2 defaults: everything denied until the visitor accepts. Must run BEFORE GTM. -->
  <script is:inline define:vars={{ pageType }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
      analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
      wait_for_update: 500,
    });
    try {
      var saved = localStorage.getItem('sc_consent');
      if (saved === 'granted') {
        gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted' });
      }
    } catch (e) {}
    dataLayer.push({ page_type: pageType });
  </script>

  {brand.gtmId && (
    <script is:inline define:vars={{ gtmId: brand.gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})
      (window,document,'script','dataLayer',gtmId);
    </script>
  )}
</head>
<body>
  {brand.gtmId && (
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${brand.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}

  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/">{brand.name}</a>
      <nav class="nav" aria-label="Principal">
        <a href="/servicios">Servicios</a>
        <a href="/nosotros" class="hide-sm">Nosotros</a>
        <a href="/contacto">Contacto</a>
        <a class="btn btn-primary" href="/contacto" data-track="cta_click" data-label="header">Solicitar valoración</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div>
        <strong>{brand.name}</strong> · {brand.serviceArea}<br />
        <a href={`tel:+${brand.phoneE164}`} data-track="phone_click" data-label="footer">{brand.phoneDisplay}</a> · <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </div>
      <div>
        <a href="/aviso-de-privacidad">Aviso de privacidad</a><br />
        © {new Date().getFullYear()} {brand.legalName}
      </div>
    </div>
  </footer>

  <a class="btn btn-wa wa-float" href={waHref} target="_blank" rel="noopener" data-track="whatsapp_click" data-label="floating" aria-label="Escríbenos por WhatsApp">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"/></svg>
    WhatsApp
  </a>

  <ConsentBanner />

  <!-- Click tracking: any element with data-track pushes a GA4-style event to the dataLayer. GTM turns these into GA4 / Meta / Ads events. -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-track]');
      if (!el) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: el.getAttribute('data-track'),
        event_label: el.getAttribute('data-label') || '',
        page_path: location.pathname,
      });
    });
  </script>
</body>
</html>
